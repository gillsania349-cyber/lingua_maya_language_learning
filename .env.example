# Gmail account that will SEND verification emails
GMAIL_USER=yourname@gmail.com

# 16-character Google App Password (not your normal Gmail password)
# Create at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: secret used to sign OTP challenges
OTP_SECRET=change-me-to-a-long-random-string

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only Supabase key (Project Settings → API → service_role).
# Needed for the admin "Premium" toggle. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin password the server checks before admin-only actions (defaults to admin123)
ADMIN_PASSWORD=

# Optional: send contact form messages to a different inbox
CONTACT_INBOX=
